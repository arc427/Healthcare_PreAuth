# AES-256 Secret Key for off-chain payload encryption (must be 32 bytes or string hashed to 32 bytes)
PREAUTH_AES_KEY=local-demo-aes-256-key-healthcare-preauth

# JWT Secret Key for authenticating hospital and insurer tokens
PREAUTH_JWT_SECRET=local-demo-jwt-secret-healthcare-preauth-secure-key

# Hardhat JSON-RPC Endpoint
PREAUTH_RPC_URL=http://127.0.0.1:8545

# Demo account passwords (override default password123)
HOSPITAL_PASSWORD=password123
INSURER_PASSWORD=password123
